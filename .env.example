# ---- Servidor ----
PORT=3000
# Banco PostgreSQL (ex.: Neon). Vazio = banco em memória, só para testes.
DATABASE_URL=
# Senha do painel (/painel e /leads). Login: usuário PAINEL_USUARIO, senha ADMIN_TOKEN.
ADMIN_TOKEN=troque-por-uma-senha-longa
PAINEL_USUARIO=admin

# ---- Segurança de envio ----
# 1 = homologação: mensagens só saem para as contas de teste abaixo. Só mude para 0 depois de testar tudo.
MODO_HOMOLOGACAO=1
# @ ou IDs do Instagram e números de WhatsApp (DDI+DDD+número) que podem receber mensagens na homologação
INSTAGRAM_TESTE=seu.perfil.pessoal
WHATSAPP_TESTE=55619XXXXXXXX

# ---- Escritório ----
ESCRITORIO_NOME="Fernando Oliveira Advocacia"
ADVOGADO_NOME="Fernando Oliveira"
OAB="OAB/DF 70.620"
INSTAGRAM_USUARIO=advfernandooliveira
# E-mail de contato exibido na política de privacidade (/privacidade). Opcional.
CONTATO_EMAIL=
# Outro WhatsApp para receber avisos de lead qualificado (com DDI, só números).
# Deixe vazio em coexistência: as conversas já aparecem no app WhatsApp Business do escritório.
ADVOGADO_WHATSAPP=

# ---- Claude (IA) ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ---- Meta (WhatsApp Cloud API + Instagram) ----
# Token de acesso permanente (System User) do Business Manager
META_ACCESS_TOKEN=
# App Secret do app na Meta (usado para validar a assinatura dos webhooks)
META_APP_SECRET=
# Texto livre que você define no painel da Meta ao cadastrar o webhook
META_VERIFY_TOKEN=um-texto-qualquer-secreto
META_GRAPH_VERSION=v23.0

# Provedor do WhatsApp: "meta" (Cloud API direto) ou "360dialog" (parceiro oficial, permite coexistência com o app)
WHATSAPP_PROVEDOR=360dialog
# Chave de API da 360dialog (gerada no painel da 360dialog para o número)
D360_API_KEY=
# Texto secreto (16+ caracteres) que protege o endereço do webhook na 360dialog
WHATSAPP_WEBHOOK_CHAVE=

# ID do número do WhatsApp Business (Phone number ID, não o número em si) — só para WHATSAPP_PROVEDOR=meta
WHATSAPP_PHONE_NUMBER_ID=
# O número do WhatsApp do escritório, com DDI, só números (usado nos links wa.me)
WHATSAPP_NUMERO=5561991658755
# 1 = a IA só atende quem chegou por post/anúncio rastreado (obrigatório com o número em coexistência,
# para não responder clientes atuais). Mensagens de outros contatos não são guardadas nem marcadas como lidas.
IA_SOMENTE_ORIGEM_RASTREADA=1

# ---- Instagram (API do Instagram com login do Instagram) ----
# ID da conta profissional do Instagram (IG User ID)
INSTAGRAM_ACCOUNT_ID=
# Token de acesso do Instagram (gerado no app, produto "Instagram")
INSTAGRAM_ACCESS_TOKEN=
# App Secret do Instagram (se vazio, usa META_APP_SECRET)
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_HOST=graph.instagram.com

# ---- Follow-up ----
# Nome do template aprovado na Meta para reengajar leads após 24h
FOLLOWUP_TEMPLATE=retomar_atendimento
FOLLOWUP_TEMPLATE_IDIOMA=pt_BR
FOLLOWUP_APOS_HORAS=24
FOLLOWUP_MAX_TENTATIVAS=2
