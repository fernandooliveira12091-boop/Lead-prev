# ---- Servidor ----
PORT=3000
# Senha do painel (/painel e /leads). Login: usuário PAINEL_USUARIO, senha ADMIN_TOKEN.
ADMIN_TOKEN=troque-por-uma-senha-longa
PAINEL_USUARIO=admin

# ---- Segurança de envio ----
# 1 = homologação: mensagens só saem para as contas de teste abaixo. Só mude para 0 depois de testar tudo.
MODO_HOMOLOGACAO=1
# @ ou IDs do Instagram e números de WhatsApp (DDI+DDD+número) que podem receber mensagens na homologação
INSTAGRAM_TESTE=seu.perfil.pessoal
WHATSAPP_TESTE=5562999999999

# ---- Escritório ----
ESCRITORIO_NOME="Escritório Exemplo Advocacia Previdenciária"
ADVOGADO_NOME="Dr(a). Fulano de Tal"
OAB="OAB/SP 000.000"
# WhatsApp do advogado que recebe os leads qualificados (com DDI, só números)
ADVOGADO_WHATSAPP=5511999999999

# ---- Claude (IA) ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ---- Meta (WhatsApp Cloud API + Instagram) ----
# Token de acesso permanente (System User) do Business Manager
META_ACCESS_TOKEN=
# App Secret do app na Meta (usado para validar a assinatura dos webhooks)
META_APP_SECRET=
# Texto livre que você define no painel da Meta ao cadastrar o webhook
META_VERIFY_TOKEN=um-texto-qualquer-secreto
META_GRAPH_VERSION=v23.0

# ID do número do WhatsApp Business (Phone number ID, não o número em si)
WHATSAPP_PHONE_NUMBER_ID=
# O número do WhatsApp do escritório, com DDI, só números (usado nos links wa.me)
WHATSAPP_NUMERO=5511988887777

# ---- Instagram (API do Instagram com login do Instagram) ----
# ID da conta profissional do Instagram (IG User ID)
INSTAGRAM_ACCOUNT_ID=
# Token de acesso do Instagram (gerado no app, produto "Instagram")
INSTAGRAM_ACCESS_TOKEN=
# App Secret do Instagram (se vazio, usa META_APP_SECRET)
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_HOST=graph.instagram.com

# ---- Follow-up ----
# Nome do template aprovado na Meta para reengajar leads após 24h
FOLLOWUP_TEMPLATE=retomar_atendimento
FOLLOWUP_TEMPLATE_IDIOMA=pt_BR
FOLLOWUP_APOS_HORAS=24
FOLLOWUP_MAX_TENTATIVAS=2
